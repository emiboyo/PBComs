NODE_ENV=development
NEXT_PUBLIC_APP_NAME=PBcoms

# Local development only. Use separate credentials and databases in test and production.
DATABASE_URL=postgresql://pbcoms:pbcoms_dev_password@localhost:5432/pbcoms
DATABASE_TEST_URL=postgresql://pbcoms_test:pbcoms_test_password@localhost:5432/pbcoms_test

# Generate at least 32 random characters for each environment. Never reuse this placeholder.
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Local development writes message previews to .auth-emails/. Production requires smtp.
EMAIL_DELIVERY_MODE=preview
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=PBcoms <no-reply@example.com>
