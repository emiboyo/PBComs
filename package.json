{
  "name": "pbcoms",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @pbcoms/database db:generate",
    "db:migrate": "pnpm --filter @pbcoms/database db:migrate",
    "db:studio": "pnpm --filter @pbcoms/database db:studio",
    "db:check": "pnpm --filter @pbcoms/database db:check",
    "db:migrations:check": "pnpm --filter @pbcoms/database db:migrations:check",
    "test:integration": "pnpm --filter @pbcoms/database test:integration && pnpm --filter @pbcoms/web test:integration"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
